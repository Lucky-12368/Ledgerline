# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerline
TOKEN_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Optional
PORT=3000
PGSSL=false                       # true for external managed Postgres
FLAG_THRESHOLD_PAISE=5000000      # transfers >= this are flagged for review (Rs 50,000)
SEED_PASSWORD=LedgerLine#2026     # password for the demo users created by `npm run seed`
# Tests only (database name MUST contain "test"; the schema is dropped on every run)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerline_test
